APP_NAME=Shortlinks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Local Docker database (see docker-compose.yml). Not a secret: it only exists on your machine.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=shortlinks
DB_USERNAME=shortlinks
DB_PASSWORD=shortlinks

# Shared across Lambda instances (in-memory or file caches are not).
CACHE_STORE=database
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

# Bearer token for the management API (/api/*). Local placeholder;
# in AWS, Terraform generates a random one.
API_TOKEN=local-dev-token

# Short links redirect from this base URL. Defaults to APP_URL.
SHORT_URL_BASE=

# Raw clicks older than this are pruned; daily aggregates are kept.
CLICK_RETENTION_DAYS=90

# CloudWatch Embedded Metric Format namespace.
METRICS_NAMESPACE=Shortlinks
METRICS_ENABLED=true
